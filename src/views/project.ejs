<%- include('partials/header') %>

<main>

    <h1><%= project.title %></h1>

    <p class="assign-category"><a href="/assign-categories/<%= project.project_id %>">Assign Project Category</a></p>

    <p class="edit-project"><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    
    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= project.project_date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Organization:</strong>

        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

</main>

<%- include('partials/footer') %>