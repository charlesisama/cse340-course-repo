<%- include('partials/header') %>

<main>

    <h1><%= project.title %></h1>

    <% if (user && user.role_name==='admin' ) { %>
        <a class="assign-category" href="/assign-categories/<%= project.project_id %>">Assign Project Category</a>
        <% } %>

    
    <% if (user && user.role_name==='admin' ) { %>
        <a class="edit-project" href="/edit-project/<%= project.project_id %>">Edit Project</a>
        <% } %>

    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= project.project_date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Organization:</strong>

        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>


    <!-- //voluteering for a project -->
    <% if (user) { %>
    
        <% if (!volunteerStatus) { %>
    
            <a href="/project/<%= project.project_id %>/volunteer" class="btn">
                Volunteer for this Project
            </a>
    
            <% } else { %>
    
                <p>
                    You are volunteering for this project.
                </p>
    
                <a href="/project/<%= project.project_id %>/remove-volunteer" class="btn btn-danger">
                    Remove Volunteer Signup
                </a>
    
                <% } %>
    
                    <% } %>

</main>

<%- include('partials/footer') %>