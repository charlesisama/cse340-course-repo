<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>

        <% if (user && user.role_name==='admin' ) { %>
            <a class="add-org" href="/new-organization">Add New Organization</a>
            <% } %>

        
        
        <div class="card-grid">
        
            <% organizations.forEach(org=> { %>
        
                <article class="card">
        
                    <h2>
                        <a href="/organization/<%= org.organization_id %>">
                            <%= org.name %>
                        </a>
                    </h2>
        
                    <p>
                        <%= org.description %>
                    </p>
        
                    <a class="card-btn" href="/organization/<%= org.organization_id %>">
                        View Organization
                    </a>
        
                </article>
        
                <% }) %>
        
        </div>

        
    </main>

    <%- include('partials/footer') %>