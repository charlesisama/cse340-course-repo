<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>

        <p>
            Name: <%= name %>
        </p>

        <p>
            Username: <%= email %>
        </p>

        <p>
            Role: <%= role %>
        </p>

        <% if (role==='admin' ) { %>

            <hr>

            <h3>Administrator Tools</h3>

            <p>
                <a href="/users">
                    View Registered Users
                </a>
            </p>

            <% } %>


        <h2>My Volunteer Projects</h2>
        
        <% if (volunteerProjects.length> 0) { %>
        
            <ul>
        
                <% volunteerProjects.forEach(project=> { %>
        
                    <li>
        
                        <strong>
                            <%= project.title %>
                        </strong>
        
                        
                        <%= project.location %>
        
                            <a href="/project/<%= project.project_id %>/remove-volunteer">
                                Remove
                            </a>
        
                    </li>
        
                    <% }) %>
        
            </ul>
        
            <% } else { %>
        
                <p>
                    You have not volunteered for any projects yet.
                </p>
        
                <% } %>
                

    </main>

    <%- include('partials/footer') %>