<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>
        

        <% if (user && user.role_name==='admin' ) { %>
            <a class="new-project" href="/new-project">Add a New Service Project</a>
            <% } %>

        <div class="card-grid">
        
            <% projects.forEach(project=> { %>
        
                <article class="card">
        
                    <h2>
                        <%= project.title %>
                    </h2>
        
                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>
        
                    <p>
                        <strong>Date:</strong>
                        <%= project.project_date %>
                    </p>
        
                    <a class="card-btn" href="/project/<%= project.project_id %>">
                        View Project
                    </a>
        
                </article>
        
                <% }) %>
        
        </div>

    </main>

    <%- include('partials/footer') %>