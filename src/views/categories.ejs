<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>
        
        <p class="new-category"><a href="/new-category">Create New Category</a></p>

        

        <p>Browse our available service project categories:</p>

        <ul>

            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>